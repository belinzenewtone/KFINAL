-- v3 -> v4: drop orphaned legacy idx_tx_* indices and recreate the body_hash index
-- on sms_ingest_queue as UNIQUE. Ported from the Room-era MIGRATION_3_4.

DROP INDEX IF EXISTS `idx_tx_inst_cat`;
DROP INDEX IF EXISTS `idx_tx_inst_date`;
DROP INDEX IF EXISTS `idx_tx_inst_extref`;
DROP INDEX IF EXISTS `idx_tx_semantic_hash`;
DROP INDEX IF EXISTS `idx_tx_source_hash`;

DROP INDEX IF EXISTS `index_sms_ingest_queue_body_hash`;
CREATE UNIQUE INDEX IF NOT EXISTS `index_sms_ingest_queue_body_hash` ON `sms_ingest_queue` (`body_hash`);
