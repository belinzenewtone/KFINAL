CREATE TABLE IF NOT EXISTS incomes (
    id            TEXT    NOT NULL PRIMARY KEY,
    amount        REAL    NOT NULL DEFAULT 0.0,
    source        TEXT,
    date          TEXT,
    note          TEXT,
    is_recurring  INTEGER NOT NULL DEFAULT 0,
    frequency     TEXT,
    is_active     INTEGER NOT NULL DEFAULT 1,
    created_at    TEXT,
    updated_at    TEXT,
    sync_state    TEXT,
    record_source TEXT,
    deleted_at    TEXT,
    revision      INTEGER NOT NULL DEFAULT 1,
    user_id       TEXT
);

CREATE INDEX IF NOT EXISTS index_incomes_date ON incomes (date);

getAll:
SELECT * FROM incomes WHERE deleted_at IS NULL ORDER BY date DESC;

getInRange:
SELECT * FROM incomes
WHERE deleted_at IS NULL AND date >= :startDate AND date <= :endDate
ORDER BY date DESC;

getTotalInRange:
SELECT SUM(amount) FROM incomes WHERE deleted_at IS NULL AND date >= :startDate AND date <= :endDate;

getById:
SELECT * FROM incomes WHERE id = :id AND deleted_at IS NULL;

search:
SELECT * FROM incomes
WHERE deleted_at IS NULL AND source LIKE '%' || :q || '%'
ORDER BY date DESC LIMIT :limit;

insertOrReplace:
INSERT OR REPLACE INTO incomes (id, amount, source, date, note, is_recurring, frequency, is_active, created_at, updated_at, sync_state, record_source, deleted_at, revision, user_id)
VALUES (:id, :amount, :source, :date, :note, :isRecurring, :frequency, :isActive, :createdAt, :updatedAt, :syncState, :recordSource, :deletedAt, :revision, :userId);

softDelete:
UPDATE incomes SET deleted_at = :timestamp WHERE id = :id;

updateActive:
UPDATE incomes SET is_active = :active WHERE id = :id;

deleteAll:
DELETE FROM incomes;
