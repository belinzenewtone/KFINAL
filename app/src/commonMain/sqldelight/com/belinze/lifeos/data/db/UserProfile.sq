CREATE TABLE IF NOT EXISTS user_profile (
    id         TEXT NOT NULL PRIMARY KEY,
    name       TEXT,
    email      TEXT,
    phone      TEXT,
    avatar_uri TEXT,
    created_at TEXT,
    updated_at TEXT
);

getProfile:
SELECT * FROM user_profile LIMIT 1;

upsert:
INSERT OR REPLACE INTO user_profile (id, name, email, phone, avatar_uri, created_at, updated_at)
VALUES (:id, :name, :email, :phone, :avatarUri, :createdAt, :updatedAt);

deleteAll:
DELETE FROM user_profile;
