CREATE TABLE IF NOT EXISTS paybill_registry (
    paybill_number TEXT    NOT NULL PRIMARY KEY,
    display_name   TEXT,
    last_seen_at   TEXT,
    usage_count    INTEGER NOT NULL DEFAULT 0,
    last_amount_kes REAL,
    user_id        TEXT
);

getPaybillName:
SELECT display_name FROM paybill_registry WHERE paybill_number = :paybillNumber;

getTopPaybills:
SELECT * FROM paybill_registry ORDER BY usage_count DESC LIMIT :limit;

upsertPaybillUsage:
INSERT OR REPLACE INTO paybill_registry (paybill_number, display_name, last_seen_at, usage_count, last_amount_kes, user_id)
VALUES (
    :paybillNumber,
    :displayName,
    :lastSeenAt,
    COALESCE((SELECT usage_count FROM paybill_registry WHERE paybill_number = :paybillNumber), 0) + 1,
    :lastAmountKes,
    (SELECT user_id FROM paybill_registry WHERE paybill_number = :paybillNumber)
);

deleteAll:
DELETE FROM paybill_registry;
