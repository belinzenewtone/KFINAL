CREATE TABLE IF NOT EXISTS bills (
    id            TEXT    NOT NULL PRIMARY KEY,
    user_id       TEXT,
    title         TEXT    NOT NULL DEFAULT '',
    amount        REAL,
    cycle         TEXT,
    next_due_date TEXT,
    last_paid_at  TEXT,
    notes         TEXT,
    is_active     INTEGER NOT NULL DEFAULT 1,
    paid_status   INTEGER NOT NULL DEFAULT 0,
    created_at    TEXT,
    updated_at    TEXT,
    sync_state    TEXT,
    deleted_at    TEXT,
    revision      INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX IF NOT EXISTS index_bills_next_due_date ON bills (next_due_date);

getActiveBills:
SELECT * FROM bills WHERE deleted_at IS NULL AND is_active = 1 ORDER BY next_due_date ASC;

getAllBills:
SELECT * FROM bills WHERE deleted_at IS NULL ORDER BY next_due_date ASC;

getBillById:
SELECT * FROM bills WHERE id = :id AND deleted_at IS NULL;

insertOrReplace:
INSERT OR REPLACE INTO bills (id, user_id, title, amount, cycle, next_due_date, last_paid_at, notes, is_active, paid_status, created_at, updated_at, sync_state, deleted_at, revision)
VALUES (:id, :userId, :title, :amount, :cycle, :nextDueDate, :lastPaidAt, :notes, :isActive, :paidStatus, :createdAt, :updatedAt, :syncState, :deletedAt, :revision);

softDelete:
UPDATE bills SET deleted_at = :ts WHERE id = :id;

deleteAll:
DELETE FROM bills;
