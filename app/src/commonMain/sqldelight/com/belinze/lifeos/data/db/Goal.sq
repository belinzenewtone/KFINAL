CREATE TABLE IF NOT EXISTS goals (
    id            TEXT    NOT NULL PRIMARY KEY,
    user_id       TEXT,
    title         TEXT    NOT NULL DEFAULT '',
    description   TEXT,
    target_value  REAL    NOT NULL DEFAULT 0.0,
    current_value REAL    NOT NULL DEFAULT 0.0,
    unit          TEXT,
    category      TEXT,
    deadline      TEXT,
    status        TEXT    NOT NULL DEFAULT 'active',
    created_at    TEXT,
    updated_at    TEXT,
    sync_state    TEXT,
    deleted_at    TEXT,
    revision      INTEGER NOT NULL DEFAULT 1
);

getAllGoals:
SELECT * FROM goals WHERE deleted_at IS NULL ORDER BY deadline ASC;

getGoalById:
SELECT * FROM goals WHERE id = :id AND deleted_at IS NULL;

insertOrReplace:
INSERT OR REPLACE INTO goals (id, user_id, title, description, target_value, current_value, unit, category, deadline, status, created_at, updated_at, sync_state, deleted_at, revision)
VALUES (:id, :userId, :title, :description, :targetValue, :currentValue, :unit, :category, :deadline, :status, :createdAt, :updatedAt, :syncState, :deletedAt, :revision);

softDelete:
UPDATE goals SET deleted_at = :ts WHERE id = :id;

deleteAll:
DELETE FROM goals;
