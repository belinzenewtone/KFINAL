CREATE TABLE IF NOT EXISTS merchant_categories (
    id            TEXT    NOT NULL PRIMARY KEY,
    merchant      TEXT    NOT NULL,
    category      TEXT,
    confidence    REAL    NOT NULL DEFAULT 0.0,
    user_corrected INTEGER NOT NULL DEFAULT 0,
    created_at    TEXT,
    updated_at    TEXT,
    sync_state    TEXT,
    record_source TEXT,
    deleted_at    TEXT,
    revision      INTEGER NOT NULL DEFAULT 1,
    user_id       TEXT
);

CREATE UNIQUE INDEX IF NOT EXISTS index_merchant_categories_merchant ON merchant_categories (merchant);

getMerchantCategory:
SELECT * FROM merchant_categories WHERE merchant = :merchant AND deleted_at IS NULL;

upsertMerchantCategory:
INSERT OR REPLACE INTO merchant_categories (id, merchant, category, confidence, user_corrected, created_at, updated_at, sync_state, record_source, deleted_at, revision, user_id)
VALUES (:id, :merchant, :category, :confidence, :userCorrected, :createdAt, :updatedAt, :syncState, :recordSource, :deletedAt, :revision, :userId);

deleteAll:
DELETE FROM merchant_categories;
