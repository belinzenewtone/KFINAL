CREATE TABLE IF NOT EXISTS assistant_messages (
    id              TEXT    NOT NULL PRIMARY KEY,
    conversation_id TEXT    NOT NULL DEFAULT 'default',
    role            TEXT    NOT NULL DEFAULT '',
    content         TEXT    NOT NULL DEFAULT '',
    actions         TEXT,
    created_at      TEXT,
    updated_at      TEXT,
    sync_state      TEXT,
    record_source   TEXT,
    deleted_at      TEXT,
    revision        INTEGER NOT NULL DEFAULT 1,
    user_id         TEXT
);

CREATE INDEX IF NOT EXISTS index_assistant_messages_conversation_id ON assistant_messages (conversation_id);
CREATE INDEX IF NOT EXISTS index_assistant_messages_created_at ON assistant_messages (created_at);

getHistory:
SELECT * FROM assistant_messages
WHERE deleted_at IS NULL AND conversation_id = :conversationId
ORDER BY created_at DESC
LIMIT 10;

observeConversation:
SELECT * FROM assistant_messages
WHERE deleted_at IS NULL AND conversation_id = :conversationId
ORDER BY created_at ASC
LIMIT 100;

insertOrReplace:
INSERT OR REPLACE INTO assistant_messages (id, conversation_id, role, content, actions, created_at, updated_at, sync_state, record_source, deleted_at, revision, user_id)
VALUES (:id, :conversationId, :role, :content, :actions, :createdAt, :updatedAt, :syncState, :recordSource, :deletedAt, :revision, :userId);

clearConversation:
UPDATE assistant_messages SET deleted_at = :ts WHERE conversation_id = :conversationId;

deleteAll:
DELETE FROM assistant_messages;
