CREATE TABLE IF NOT EXISTS budgets (
    id              TEXT    NOT NULL PRIMARY KEY,
    category        TEXT    NOT NULL DEFAULT '',
    limit_amount    REAL    NOT NULL DEFAULT 0.0,
    period          TEXT    NOT NULL DEFAULT 'monthly',
    alert_threshold REAL,
    is_active       INTEGER NOT NULL DEFAULT 1,
    created_at      TEXT,
    updated_at      TEXT,
    sync_state      TEXT,
    record_source   TEXT,
    deleted_at      TEXT,
    revision        INTEGER NOT NULL DEFAULT 1,
    user_id         TEXT
);

CREATE INDEX IF NOT EXISTS index_budgets_category ON budgets (category);
CREATE INDEX IF NOT EXISTS index_budgets_deleted_at ON budgets (deleted_at);

getActive:
SELECT * FROM budgets WHERE deleted_at IS NULL AND is_active = 1 ORDER BY category ASC;

getAll:
SELECT * FROM budgets WHERE deleted_at IS NULL ORDER BY category ASC;

getById:
SELECT * FROM budgets WHERE id = :id AND deleted_at IS NULL;

search:
SELECT * FROM budgets
WHERE deleted_at IS NULL AND category LIKE '%' || :q || '%'
ORDER BY category ASC LIMIT :limit;

insertOrReplace:
INSERT OR REPLACE INTO budgets (id, category, limit_amount, period, alert_threshold, is_active, created_at, updated_at, sync_state, record_source, deleted_at, revision, user_id)
VALUES (:id, :category, :limitAmount, :period, :alertThreshold, :isActive, :createdAt, :updatedAt, :syncState, :recordSource, :deletedAt, :revision, :userId);

softDelete:
UPDATE budgets SET deleted_at = :timestamp WHERE id = :id;

deleteAll:
DELETE FROM budgets;
