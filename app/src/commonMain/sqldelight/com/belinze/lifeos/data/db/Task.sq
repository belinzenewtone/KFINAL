CREATE TABLE IF NOT EXISTS tasks (
    id                  TEXT    NOT NULL PRIMARY KEY,
    title               TEXT    NOT NULL DEFAULT '',
    description         TEXT,
    priority            TEXT    NOT NULL DEFAULT 'medium',
    deadline            TEXT,
    status              TEXT    NOT NULL DEFAULT 'active',
    completed_at        TEXT,
    created_at          TEXT,
    updated_at          TEXT,
    reminder_offsets    TEXT,
    alarm_enabled       INTEGER NOT NULL DEFAULT 0,
    sync_state          TEXT,
    record_source       TEXT,
    deleted_at          TEXT,
    revision            INTEGER NOT NULL DEFAULT 1,
    user_id             TEXT,
    time_spent_seconds  INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS index_tasks_deadline ON tasks (deadline);
CREATE INDEX IF NOT EXISTS index_tasks_status ON tasks (status);
CREATE INDEX IF NOT EXISTS index_tasks_deleted_at ON tasks (deleted_at);
CREATE INDEX IF NOT EXISTS index_tasks_status_deadline ON tasks (status, deadline);

getAll:
SELECT * FROM tasks WHERE deleted_at IS NULL ORDER BY deadline ASC, created_at DESC;

getUpcoming:
SELECT * FROM tasks
WHERE deleted_at IS NULL AND status = 'active'
  AND deadline IS NOT NULL AND deadline <= :dueBefore
ORDER BY deadline ASC
LIMIT :limit;

countPending:
SELECT COUNT(*) FROM tasks WHERE deleted_at IS NULL AND status = 'active';

countDueToday:
SELECT COUNT(*) FROM tasks
WHERE deleted_at IS NULL AND status = 'active'
  AND deadline IS NOT NULL
  AND deadline >= :startOfDay AND deadline <= :endOfDay;

getById:
SELECT * FROM tasks WHERE id = :id AND deleted_at IS NULL;

search:
SELECT * FROM tasks
WHERE deleted_at IS NULL AND (title LIKE '%' || :q || '%' OR description LIKE '%' || :q || '%')
ORDER BY deadline ASC LIMIT :limit;

observeAll:
SELECT * FROM tasks WHERE deleted_at IS NULL ORDER BY deadline ASC;

insertOrReplace:
INSERT OR REPLACE INTO tasks (id, title, description, priority, deadline, status, completed_at, created_at, updated_at, reminder_offsets, alarm_enabled, sync_state, record_source, deleted_at, revision, user_id, time_spent_seconds)
VALUES (:id, :title, :description, :priority, :deadline, :status, :completedAt, :createdAt, :updatedAt, :reminderOffsets, :alarmEnabled, :syncState, :recordSource, :deletedAt, :revision, :userId, :timeSpentSeconds);

softDelete:
UPDATE tasks SET deleted_at = :timestamp WHERE id = :id;

countCompletedSince:
SELECT COUNT(*) FROM tasks
WHERE deleted_at IS NULL
  AND status = 'done'
  AND (completed_at >= :since OR (completed_at IS NULL AND updated_at >= :since));

countAllPending:
SELECT COUNT(*) FROM tasks
WHERE deleted_at IS NULL AND status != 'done';

deleteAll:
DELETE FROM tasks;
