root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ktlint: this codebase predates ktlint's formatter opinions (aligned
# assignments, hand-wrapped argument lists). The purely cosmetic format rules
# are disabled so ktlintCheck enforces correctness/style rules without a
# 12k-finding reformat. Adopting them later = one `gradlew ktlintFormat` run.
[*.{kt,kts}]
ktlint_standard_no-multi-spaces = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_parameter-list-spacing = disabled
ktlint_standard_wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_indent = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_statement-wrapping = disabled
ktlint_standard_if-else-wrapping = disabled
ktlint_standard_string-template-indent = disabled
# SCREAMING_SNAKE `private val` SQL/regex constants are intentional
ktlint_standard_property-naming = disabled
# detekt enforces 140 with better exclusions; ktlint's copy flags raw strings
ktlint_standard_max-line-length = disabled
ktlint_standard_discouraged-comment-location = disabled
