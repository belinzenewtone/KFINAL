# Normalise all text files to LF in the repo; check out as-is on Windows
* text=auto eol=lf

# Shell scripts must stay LF even on Windows
gradlew text eol=lf

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
